# Google Generative AI API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI API Key (optional, for future support)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (optional, for future support)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Provider: 'gemini', 'openai', or 'anthropic'
LLM_PROVIDER=gemini

# Original target webpage URL
ORIGINAL_URL=http://127.0.0.1:5000

# Updated/alternative target URL (for testing selector healing)
UPDATED_URL=http://127.0.0.1:5000/updated
